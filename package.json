{
  "name": "eonsort",
  "version": "0.0.0-dev",
  "description": "Sort files into date-based folders",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:e2e": "wdio run tests/e2e/wdio.conf.js",
    "icon": "node scripts/make-icon.mjs src-tauri/icons/source.png && tauri icon src-tauri/icons/source.png",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-opener": "^2"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/kit": "^2.70.1",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.1.2",
    "@wdio/cli": "^9.30.1",
    "@wdio/local-runner": "^9.30.1",
    "@wdio/mocha-framework": "^9.30.1",
    "@wdio/spec-reporter": "^9.30.1",
    "edgedriver": "^6.3.0",
    "svelte": "^5.56.4",
    "svelte-check": "^4.7.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.3",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "cookie": "0.7.2",
    "serialize-javascript": "7.1.0"
  }
}
